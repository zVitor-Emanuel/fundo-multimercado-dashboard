let portfolioData = null;
let marketData = null;
let historyData = null;
let macroData = null;


// ========================================
// CARREGAR DADOS
// ========================================

async function loadData() {

    try {

        console.log("Iniciando carregamento dos dados...");


        // ========================================
        // CONFIG
        // ========================================

        const configResponse =
            await fetch("config/portfolio.json");


        // ========================================
        // PORTFOLIO CALCULADO
        // ========================================

        const portfolioResponse =
            await fetch("data/portfolio.json");


        // ========================================
        // MARKET
        // ========================================

        const marketResponse =
            await fetch("data/market.json");


        // ========================================
        // HISTORY
        // ========================================

        const historyResponse =
            await fetch("data/history.json");


        // ========================================
        // MACRO
        // ========================================

        const macroResponse =
            await fetch("data/macro.json");


        // ========================================
        // VERIFICAR RESPOSTAS
        // ========================================

        if (!configResponse.ok) {
            throw new Error(
                `Erro ao carregar config/portfolio.json: ${configResponse.status}`
            );
        }

        if (!portfolioResponse.ok) {
            throw new Error(
                `Erro ao carregar data/portfolio.json: ${portfolioResponse.status}`
            );
        }

        if (!marketResponse.ok) {
            throw new Error(
                `Erro ao carregar data/market.json: ${marketResponse.status}`
            );
        }

        if (!historyResponse.ok) {
            throw new Error(
                `Erro ao carregar data/history.json: ${historyResponse.status}`
            );
        }

        if (!macroResponse.ok) {
            throw new Error(
                `Erro ao carregar data/macro.json: ${macroResponse.status}`
            );
        }


        // ========================================
        // CONVERTER JSON
        // ========================================

        const configData =
            await configResponse.json();

        portfolioData =
            await portfolioResponse.json();

        marketData =
            await marketResponse.json();

        historyData =
            await historyResponse.json();

        macroData =
            await macroResponse.json();


        // ========================================
        // DEBUG
        // ========================================

        console.log("Config:", configData);

        console.log(
            "Portfolio calculado:",
            portfolioData
        );

        console.log(
            "Market:",
            marketData
        );

        console.log(
            "History:",
            historyData
        );

        console.log(
            "Macro:",
            macroData
        );


        // ========================================
        // VALIDAR PORTFOLIO
        // ========================================

        if (!portfolioData) {
            throw new Error(
                "data/portfolio.json retornou vazio."
            );
        }

        if (!Array.isArray(portfolioData.positions)) {
            throw new Error(
                "data/portfolio.json não possui 'positions'."
            );
        }


        // ========================================
        // INICIALIZAR
        // ========================================

        initializeDashboard();


    } catch (error) {

        console.error(
            "Erro ao carregar dados:",
            error
        );

    }

}


// ========================================
// INICIALIZAR DASHBOARD
// ========================================

function initializeDashboard() {

    console.log(
        "Inicializando dashboard..."
    );


    renderPortfolio();

    updateFundInfo();

    updateMacro();

    updateDate();

}


// ========================================
// CARTEIRA
// ========================================

function renderPortfolio() {

    const table =
        document.getElementById(
            "portfolio-table"
        );


    if (!table) {

        console.error(
            "Elemento #portfolio-table não encontrado."
        );

        return;

    }


    table.innerHTML = "";


    portfolioData.positions.forEach(
        asset => {

            const row =
                document.createElement("tr");


            // ========================================
            // P&L
            // ========================================

            let pnlText = "--";

            let statusText =
                asset.status || "SEM STATUS";

            let statusClass = "";


            if (
                asset.contribution !== null &&
                asset.contribution !== undefined
            ) {

                pnlText =
                    formatPercent(
                        asset.contribution
                    );


                if (
                    asset.contribution >= 0
                ) {

                    statusClass =
                        "positive-text";

                } else {

                    statusClass =
                        "negative-text";

                }

            }


            // ========================================
            // LINHA
            // ========================================

            row.innerHTML = `

                <td>

                    <strong>
                        ${asset.name}
                    </strong>

                    <br>

                    <small>
                        ${asset.ticker}
                    </small>

                </td>


                <td>
                    ${asset.category}
                </td>


                <td>
                    ${asset.position}
                </td>


                <td>
                    ${(asset.weight * 100).toFixed(0)}%
                </td>


                <td class="${statusClass}">
                    ${pnlText}
                </td>


                <td>

                    <span class="${statusClass}">
                        ${statusText}
                    </span>

                </td>

            `;


            table.appendChild(row);

        }
    );

}


// ========================================
// INFORMAÇÕES DO FUNDO
// ========================================

function updateFundInfo() {

    let nav;
    let returnValue;
    let pnl;

    // ========================================
    // CARTEIRA COMPLETA
    // ========================================

    if (portfolioData.status === "OK") {

        nav =
            portfolioData.current_nav;

        returnValue =
            portfolioData.return;

        pnl =
            portfolioData.pnl;

    }

    // ========================================
    // CARTEIRA PARCIAL
    // ========================================

    else if (portfolioData.status === "PARCIAL") {

        nav =
            portfolioData.partial_nav;

        returnValue =
            portfolioData.partial_return;

        pnl =
            portfolioData.partial_pnl;

    }

    // ========================================
    // SEM DADOS
    // ========================================

    else {

        nav = null;
        returnValue = null;
        pnl = null;

    }


    // ========================================
    // NAV
    // ========================================

    document.getElementById("nav")
        .textContent =
        nav !== null && nav !== undefined
            ? formatCurrency(nav)
            : "--";


    // ========================================
    // RETORNO
    // ========================================

    document.getElementById("return")
        .textContent =
        returnValue !== null && returnValue !== undefined
            ? formatPercent(returnValue)
            : "--";


    // ========================================
    // P&L
    // ========================================

    document.getElementById("daily-pnl")
        .textContent =
        pnl !== null && pnl !== undefined
            ? formatCurrency(pnl)
            : "--";


    // ========================================
    // DRAWDOWN
    // ========================================

    document.getElementById("drawdown")
        .textContent =
        "N/D";

}


// ========================================
// MACRO
// ========================================

function updateMacro() {

    document.getElementById(
        "inflation"
    ).textContent = "--";


    document.getElementById(
        "inflation-status"
    ).textContent =
        "Aguardando dados";


    document.getElementById(
        "selic"
    ).textContent = "--";


    document.getElementById(
        "selic-status"
    ).textContent =
        "Aguardando dados";


    document.getElementById(
        "usd"
    ).textContent = "--";


    document.getElementById(
        "usd-status"
    ).textContent =
        "Aguardando dados";


    document.getElementById(
        "brent"
    ).textContent = "--";


    document.getElementById(
        "brent-status"
    ).textContent =
        "Aguardando dados";

}


// ========================================
// DATA
// ========================================

function updateDate() {

    const startDate =
        new Date(
            portfolioData.start_date +
            "T00:00:00"
        );


    const currentDate =
        new Date(
            portfolioData.current_date +
            "T00:00:00"
        );


    const formattedStartDate =
        startDate.toLocaleDateString(
            "pt-BR"
        );


    const formattedCurrentDate =
        currentDate.toLocaleDateString(
            "pt-BR"
        );


    document.getElementById(
        "portfolio-date"
    ).textContent =
        `Entrada: ${formattedStartDate}`;


    document.getElementById(
        "last-update"
    ).textContent =
        `Data-base: ${formattedCurrentDate}`;

}


// ========================================
// FORMATAÇÃO
// ========================================

function formatCurrency(value) {

    if (
        value === null ||
        value === undefined ||
        isNaN(value)
    ) {

        return "--";

    }


    return new Intl.NumberFormat(
        "pt-BR",
        {
            style: "currency",
            currency: "BRL"
        }
    ).format(value);

}


// ========================================
// FORMATAÇÃO DE PERCENTUAL
// ========================================

function formatPercent(value) {

    if (
        value === null ||
        value === undefined ||
        isNaN(value)
    ) {

        return "--";

    }


    const sign =
        value > 0
            ? "+"
            : "";


    return (
        sign +
        (value * 100)
            .toFixed(2)
            .replace(".", ",") +
        "%"
    );

}


// ========================================
// START
// ========================================

loadData();